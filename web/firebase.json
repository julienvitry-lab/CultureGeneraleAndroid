{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/quizypedia",
        "function": {
          "functionId": "cgimport002Quizypedia",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/cgweb032",
        "function": {
          "functionId": "cgweb032Search",
          "region": "europe-west1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
